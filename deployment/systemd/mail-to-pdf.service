# systemd-Dienst für mail-to-pdf (lokaler Betrieb auf dieser VM)
#
# Installation:
#   sudo cp deployment/systemd/mail-to-pdf.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mail-to-pdf
#
# Logs:
#   journalctl -u mail-to-pdf -f

[Unit]
Description=mail-to-pdf - Mailpostfach nach PDF-Upload auf Webserver
Documentation=file:/home/cbot/PycharmProjects/mail-to-pdf/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cbot
Group=cbot
WorkingDirectory=/home/cbot/PycharmProjects/mail-to-pdf

# Alle Variablen aus der .env; systemd liest die Datei wörtlich (keine Shell),
# Sonderzeichen wie !! oder $ im Passwort bleiben dadurch unangetastet.
EnvironmentFile=/home/cbot/PycharmProjects/mail-to-pdf/private/.env

Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/cbot/PycharmProjects/mail-to-pdf/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=10

# Journal: eigener Bezeichner für gezielte Abfragen
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mail-to-pdf
SyslogLevelPrefix=false

# Härtung
NoNewPrivileges=true
PrivateTmp=no
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
