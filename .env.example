# Vorlage für den lokalen Test - als .env kopieren und ausfüllen.
IMAP_HOST=imap.example.org
IMAP_PORT=993
IMAP_SSL=true
# TODO: echte Postfachadresse eintragen
IMAP_USER=speiseplan@example.org
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
POLL_INTERVAL=60

SENDER_ALLOWLIST=sekretariat@example.org
SUBJECT_REGEX=speiseplan
ATTACHMENT_SUFFIXES=.pdf
# optional: Regex auf den Dateinamen des Anhangs
ATTACHMENT_NAME_REGEX=
MAX_ATTACHMENT_MB=25

SSH_HOST=www.example.org
SSH_PORT=22
SSH_USER=speiseplan
SSH_PRIVATE_KEY_FILE=/run/secrets/id_ed25519
SSH_HOST_FINGERPRINT=SHA256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
REMOTE_DIR=/var/www/example-web/dokumente
REMOTE_FILENAME=Speiseplan.pdf

STATE_FILE=/tmp/mail-to-pdf-state.json
LOG_LEVEL=INFO

# Bestaetigung an den Absender (SMTP, gleiche Zugangsdaten wie IMAP)
REPLY_ENABLED=false
REPLY_ON_DRY_RUN=false
REPLY_TEXT=Die Datei wurde erfolgreich übertragen.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
